# ==========================================
# Authentication (Better Auth)
# ==========================================
# Secret key used to encrypt sessions. Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET=your_32_character_random_secret_string
# Base URL of your app
BETTER_AUTH_URL=http://localhost:3000

# ==========================================
# Google OAuth (For Social Login)
# ==========================================
# Get these from Google Cloud Console > Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ==========================================
# Database (Turso / LibSQL)
# ==========================================
# Get these from your Turso Dashboard
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# ==========================================
# Artificial Intelligence
# ==========================================
# Get this from Google AI Studio
GOOGLE_GENERATIVE_AI_API_KEY=your_google_gemini_api_key
# (Optional) Alternative if you want to use OpenAI
OPENAI_API_KEY=your_openai_api_key

# ==========================================
# Application Settings
# ==========================================
# Public URL accessible by the frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# Monetization (Polar)
# ==========================================
# Organization access token. Products, prices and webhooks are managed
# automatically from Dashboard > Admin > Settings > Payments.
POLAR_ACCESS_TOKEN=polar_oat_your_organization_access_token
